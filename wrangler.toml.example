# Example for those who deploy with wrangler. Copy to wrangler.toml (kept out of Git) and fill it in.
# The real limit values do NOT go here: use the dashboard or `wrangler secret put`.

name = "your-worker-name"
main = "src/worker.js"
compatibility_date = "2026-08-01"

# Keeps the variables created in the dashboard when you deploy with wrangler.
keep_vars = true

[ai]
binding = "AI"

[[kv_namespaces]]
binding = "STATE"
id = "<YOUR_KV_NAMESPACE_ID>"

# Optional: Rate Limiting binding (only configurable through the config file).
# namespace_id is an integer, as a string, unique in your account. The numbers below are examples.
[[ratelimits]]
name = "RATE_LIMITER"
namespace_id = "<UNIQUE_INTEGER_IN_YOUR_ACCOUNT>"
  [ratelimits.simple]
  limit = 10
  period = 60

# No logs stored by the platform (the code itself logs nothing).
[observability]
enabled = false
