# Copy to .dev.vars (protected by .gitignore) and replace with your own values.
# All numbers below are EXAMPLES for local development, not recommendations.
# In production, each item becomes a variable or a secret in the Worker dashboard.

# Limits (text)
RATE_LIMIT_PER_MINUTE=3
WEEKLY_LIMIT_PER_IP=5
DAILY_QUESTION_CAP=20
DAILY_NEURON_CAP=400
MAX_TOKENS=128
MAX_INPUT_CHARS=200

# Allowed origin (text): the exact address of the page, no trailing slash.
ALLOWED_ORIGIN=http://localhost:8787

# Turnstile: public TEST keys from the Cloudflare documentation (they always pass).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Secret: long random text (at least 16 characters). Generate your own.
HASH_SALT=replace-with-a-long-random-string

# Secret (optional): the real system prompt. Without it, the app uses a generic example.
SYSTEM_PROMPT=You are the assistant of an educational test app. Only answer about the app's topic.

# Emergency switch: 1 turns the app off.
APP_DISABLED=0

# Optional: ID of your own AI Gateway.
# AI_GATEWAY_ID=
